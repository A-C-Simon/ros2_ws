<?xml version="1.0" ?>
<!--
  Indoor test-station world for the Task2 AI Rover.
  Replaces the open crop field with the enclosed test_zone building model.
  The rover spawns in the large open room on the east side of the building;
  the charging dock and obstacle boxes are placed in the same room.
-->
<sdf version="1.8">
  <world name="test_station">

    <!-- Explicit DART physics profile. "ignored" was not a valid engine type
         (valid: ode|bullet|simbody|dart), so gz-sim fell back to defaults and no
         tuned profile was applied. type="dart" pins the dartsim engine; the
         solver/collision_detector stay at DART's battle-tested defaults. -->
    <physics name="dart" type="dart" default="true">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"       name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <!-- IMU sensors need their own system plugin (unlike gpu_lidar/camera which
         the Sensors system handles directly). Without it the per-rover <sensor
         type="imu"> tags are never instantiated, so /<ns>/imu never publishes. -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 -0.4 -0.9</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <grid>false</grid>
    </scene>

    <!-- Concrete ground plane (large enough for the 16 x 18 m building). -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.35 0.35 0.36 1</ambient>
            <diffuse>0.40 0.40 0.41 1</diffuse>
            <specular>0.08 0.08 0.09 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- White test-station building (test_zone model). -->
    <include>
      <uri>model://test_zone</uri>
      <pose>0 0 0 0 0 0</pose>
      <name>test_zone_building</name>
    </include>

    <!-- Obstacle boxes near the rover spawn so the sonars register something close.
         rover_0 faces -X.  One box is directly ahead (front-sonar target), the other
         two are behind and off to the sides so the forward lane and the docking
         approach stay clear and multi-rover spawns on the Y line don't collide. -->
    <model name="box_ahead">
      <static>true</static>
      <pose>2.2 0.4 0.1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.75 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_left">
      <static>true</static>
      <pose>4.2 1.6 0.1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.75 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_right">
      <static>true</static>
      <pose>4.2 -0.8 0.1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.75 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Charging / docking station.
         Placed against the east wall of the large room; mouth opens toward -X,
         so the rover (spawned at x≈3.3, yaw≈π) reverses into it. -->
    <model name="charging_station_0">
      <static>true</static>
      <pose>5.0 0.4 0 0 0 3.141592653589793</pose>
      <link name="base">
        <visual name="pad_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.32 0.30 0.01</size></box></geometry><material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.22 0.22 0.25 1</diffuse></material></visual>
        <collision name="pad_c"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.32 0.30 0.01</size></box></geometry></collision>

        <visual name="back_v"><pose>-0.15 0 0.04 0 0 0</pose><geometry><box><size>0.02 0.25 0.08</size></box></geometry><material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
        <collision name="back_c"><pose>-0.15 0 0.04 0 0 0</pose><geometry><box><size>0.02 0.25 0.08</size></box></geometry></collision>

        <visual name="wall_L_v"><pose>0 0.10 0.04 0 0 0.2606</pose><geometry><box><size>0.31 0.015 0.08</size></box></geometry><material><ambient>0.55 0.45 0.10 1</ambient><diffuse>0.75 0.60 0.15 1</diffuse></material></visual>
        <collision name="wall_L_c"><pose>0 0.10 0.04 0 0 0.2606</pose><geometry><box><size>0.31 0.015 0.08</size></box></geometry></collision>

        <visual name="wall_R_v"><pose>0 -0.10 0.04 0 0 -0.2606</pose><geometry><box><size>0.31 0.015 0.08</size></box></geometry><material><ambient>0.55 0.45 0.10 1</ambient><diffuse>0.75 0.60 0.15 1</diffuse></material></visual>
        <collision name="wall_R_c"><pose>0 -0.10 0.04 0 0 -0.2606</pose><geometry><box><size>0.31 0.015 0.08</size></box></geometry></collision>

        <visual name="pin_L_v"><pose>-0.135 0.03 0.03 0 1.5708 0</pose><geometry><cylinder><radius>0.008</radius><length>0.02</length></cylinder></geometry><material><ambient>0.55 0.30 0.10 1</ambient><diffuse>0.80 0.45 0.15 1</diffuse></material></visual>
        <collision name="pin_L_c"><pose>-0.135 0.03 0.03 0 1.5708 0</pose><geometry><cylinder><radius>0.008</radius><length>0.02</length></cylinder></geometry></collision>
        <visual name="pin_R_v"><pose>-0.135 -0.03 0.03 0 1.5708 0</pose><geometry><cylinder><radius>0.008</radius><length>0.02</length></cylinder></geometry><material><ambient>0.55 0.30 0.10 1</ambient><diffuse>0.80 0.45 0.15 1</diffuse></material></visual>
        <collision name="pin_R_c"><pose>-0.135 -0.03 0.03 0 1.5708 0</pose><geometry><cylinder><radius>0.008</radius><length>0.02</length></cylinder></geometry></collision>

        <visual name="mast_v"><pose>-0.15 0 0.15 0 0 0</pose><geometry><box><size>0.02 0.10 0.14</size></box></geometry><material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material></visual>
        <collision name="mast_c"><pose>-0.15 0 0.15 0 0 0</pose><geometry><box><size>0.02 0.10 0.14</size></box></geometry></collision>
        <visual name="tag_v"><pose>-0.139 0 0.20 0 0 0</pose><geometry><box><size>0.002 0.06 0.06</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>

        <visual name="led_v"><pose>-0.15 0 0.235 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.015</length></cylinder></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.2 0.9 0.2 1</diffuse><emissive>0.1 0.5 0.1 1</emissive></material></visual>
      </link>
    </model>

  </world>
</sdf>
